# Root .env example for project overview

# Backend
MONGO_URI=mongodb://localhost:27017/newroots
JWT_SECRET=replace_with_a_strong_secret
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# SMTP (used by backend for OTP / notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret
EMAIL_FROM="NewRoots" <no-reply@example.com>

# Frontend (Vite) env variables should be set in frontend/.env or CI
VITE_API_URL=http://localhost:5000
