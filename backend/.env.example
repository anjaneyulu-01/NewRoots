# Example backend environment variables (do NOT commit secrets)

# Server
PORT=5000
NODE_ENV=development

# Database (choose one)
#MONGO_LOCAL=mongodb://127.0.0.1:27017/newroots
#MONGO_ATLAS=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/newroots

# Auth
JWT_SECRET=replace_with_a_strong_random_value

# App / API URLs
#API_URL=https://api.example.com
#APP_URL=https://app.example.com

# Google
#GOOGLE_CLIENT_ID=your-google-client-id
#GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =========================
# SMTP / Email (for Nodemailer)
# =========================
# Example for a typical SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-password
# Set to 'true' if using SMTPS (port 465)
SMTP_SECURE=false
# Optional From header shown in emails
EMAIL_FROM="NewRoots <no-reply@example.com>"


# Server
# =========================
PORT=5000
NODE_ENV=development

# =========================
# Database
# =========================
MONGO_LOCAL=mongodb://127.0.0.1:27017/newroots
MONGO_ATLAS=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/newroots

# =========================
# Auth
# =========================
JWT_SECRET=your-jwt-secret

# =========================
# APIs
# =========================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
